# ==========================================
# DISCORD BOT CREDENTIALS
# ==========================================
# Dapatkan token bot dari https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Application / Client ID dari bot Anda
CLIENT_ID=your_client_id_here

# (Opsional) Guild / Server ID jika ingin mendaftarkan slash command secara instan ke 1 server untuk pengujian
# Kosongkan jika ingin didaftarkan ke seluruh server secara Global (butuh waktu sync ~1 jam pada Discord)
GUILD_ID=

# ==========================================
# SPOTIFY API (OPSIONAL TAPI DISARANKAN)
# ==========================================
# Dapatkan dari https://developer.spotify.com/dashboard
# Jika dikosongkan, bot akan tetap mencoba mengambil info lagu Spotify via scraper
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
